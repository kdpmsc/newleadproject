# Copy to .env and fill in secrets. Never commit real .env values.

# --- Basic Auth users (required for protected APIs; passwords are env-only) ---
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-admin
APP_SALES_USERNAME=sales
APP_SALES_PASSWORD=change-me-sales
APP_COMPLIANCE_USERNAME=compliance
APP_COMPLIANCE_PASSWORD=change-me-compliance

# --- CORS / frontend ---
FRONTEND_ORIGIN=http://localhost:5500
# Comma-separated extra origins merged with application.yml defaults
CORS_ALLOWED_ORIGINS=

# --- Voice / Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_RECORD_CALL=false
VOICE_PROVIDER=twilio

# Public HTTPS base URL Twilio calls for webhooks (ngrok or server).
# scripts/run-local-ngrok.ps1 sets these automatically.
APP_PUBLIC_BASE_URL=http://localhost:8080
TWILIO_APP_BASE_URL=http://localhost:8080

# Optional reserved ngrok domain so the public URL stays stable.
# NGROK_DOMAIN=your-name.ngrok-free.dev

# --- AI provider: ollama | openai | openrouter | anthropic ---
AI_PROVIDER=ollama
AI_CONNECT_TIMEOUT_MS=5000
AI_READ_TIMEOUT_MS=45000
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=120
AI_MAX_CONVERSATION_CHARS=1200

# Ollama (default). Inside Docker Compose use http://ollama:11434;
# on the host (IDE) use http://localhost:11434.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_CHAT_PATH=/api/chat
OLLAMA_NUM_PREDICT=120
OLLAMA_NUM_CTX=1024
OLLAMA_TEMPERATURE=0.3
OLLAMA_KEEP_ALIVE=30m

# OpenAI (set AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_PATH=/v1/chat/completions

# OpenRouter (set AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=leadproject
OPENROUTER_CHAT_PATH=/v1/chat/completions

# Anthropic / Claude (set AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MESSAGES_PATH=/v1/messages

# Optional voice script overrides (full defaults in application.yml under app.voice)
VOICE_COMPANY_NAME=XYZ Properties
VOICE_THINK_BUDGET_MS=40000
VOICE_MAX_THINK_POLLS=10
VOICE_SPEECH_LANGUAGE=en-US
# VOICE_IV_Q1=Are you looking to buy, rent, sell, or invest?
# VOICE_IV_Q2=Which area and property type are you considering?
# VOICE_IV_Q3=What budget range are you comfortable with?
# VOICE_IV_Q4=When do you plan to purchase?
# VOICE_IV_Q5=Are you the decision maker?
# VOICE_IV_Q6=When should a property consultant contact you?

# Plivo (optional; VOICE_PROVIDER=plivo)
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=
# PLIVO_PHONE_NUMBER=
# PLIVO_APP_BASE_URL=http://localhost:8080
# PLIVO_API_BASE_URL=https://api.plivo.com
# PLIVO_CALL_PATH_TEMPLATE=/v1/Account/{authId}/Call/
# PLIVO_RING_TIMEOUT_SECONDS=45